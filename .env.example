# Copiar a .env y rellenar con la modal Connect de https://console.neon.tech
# Neon exige TLS: sslmode=require (channel_binding=require en strings actuales).
# App/serverless: host con -pooler. Migraciones/pg_dump/replicación: host sin -pooler.

# --- Nodo Central ---
CENTRAL_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
CENTRAL_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
CENTRAL_PGHOST=ep-xxxx-pooler.REGION.aws.neon.tech
CENTRAL_PGUSER=USER
CENTRAL_PGPASSWORD=PASSWORD
CENTRAL_PGDATABASE=DBNAME
CENTRAL_PGPORT=5432
CENTRAL_PGSSLMODE=require

# --- Nodo Local (farmacia) ---
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
LOCAL_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
LOCAL_PGHOST=ep-yyyy-pooler.REGION.aws.neon.tech
LOCAL_PGUSER=USER
LOCAL_PGPASSWORD=PASSWORD
LOCAL_PGDATABASE=DBNAME
LOCAL_PGPORT=5432
LOCAL_PGSSLMODE=require
