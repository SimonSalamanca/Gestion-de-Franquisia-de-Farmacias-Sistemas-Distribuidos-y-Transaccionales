{
  "name": "farmahub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node apps/api/server.mjs\" \"npm run dev --prefix apps/web\"",
    "api": "node apps/api/server.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:verificar": "node scripts/db-verificar.mjs",
    "db:depurar-umbrales": "node scripts/depurar-umbrales.mjs",
    "test": "node scripts/probar-hu06.mjs && node scripts/db-verificar.mjs",
    "test:hu06": "node scripts/probar-hu06.mjs",
    "test:hu01": "node scripts/probar-hu01.mjs",
    "test:hu02": "node scripts/probar-hu02.mjs",
    "test:hu03": "node scripts/probar-hu03.mjs",
    "test:hu04": "node scripts/probar-hu04.mjs",
    "test:hu07": "node scripts/probar-hu07.mjs",
    "test:hu08": "node scripts/probar-hu08.mjs",
    "test:hu09": "node scripts/probar-hu09.mjs",
    "test:hu15": "node scripts/probar-hu15.mjs && node scripts/probar-hu15-http.mjs",
    "test:sync": "node scripts/probar-sincronizacion.mjs",
    "web": "npm run dev --prefix apps/web",
    "test:hu12": "node scripts/probar-hu12.mjs && node scripts/probar-hu12-central.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
